<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <RootNamespace>Mediator.Lite</RootNamespace>
    <AssemblyName>Mediator.Lite</AssemblyName>
    <PackageId>Mediator.Lite</PackageId>
    <PackageVersion>0.0.9.0</PackageVersion>
    <PackageTags>mediator;mediatr;cqrs;command;query;command-query</PackageTags>
    <Authors>Wengwalker</Authors>
    <Title>Mediator.Lite library</Title>
    <Description>Simple implementation of mediator for .NET</Description>

    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <PackageProjectUrl>https://github.com/wengwalker/Mediator.Lite</PackageProjectUrl>
    <RepositoryUrl>https://github.com/wengwalker/Mediator.Lite</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <IncludeSymbols>true</IncludeSymbols>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
    <None Include="..\..\LICENSE" Pack="true" PackagePath="\" />
  </ItemGroup>

	<ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.8" />
  </ItemGroup>

</Project>
